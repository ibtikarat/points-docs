{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Points",
  "description": "Points API - Saudi Arabia's unified loyalty rewards platform",
  "seo": {
    "metatags": {
      "title": "Points API Documentation",
      "description": "Official developer documentation for the Points API — Saudi Arabia's unified loyalty rewards platform.",
      "application-name": "Points",
      "og:title": "Points API Documentation",
      "og:description": "Official developer documentation for the Points API — Saudi Arabia's unified loyalty rewards platform.",
      "og:site_name": "Points",
      "og:locale": "en_US",
      "twitter:title": "Points API Documentation",
      "twitter:description": "Official developer documentation for the Points API — Saudi Arabia's unified loyalty rewards platform."
    },
    "indexing": "navigable"
  },
  "colors": {
    "primary": "#000000",
    "light": "#111111",
    "dark": "#5F4BE8"
  },
  "background": {
    "style": "gradient"
  },
  "backgroundImage": "/images/points-docs-background.svg",
  "font": {
    "family": "Ping AR + LT",
    "url": "/fonts/PingARLT-Regular.woff2",
    "format": "woff2",
    "weight": 400
  },
  "favicon": "/favicon.png",
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Introduction",
            "pages": [
              "introduction/what-is-points",
              "introduction/technical-requirements",
              "introduction/faq",
              "introduction/quickstart"
            ]
          },
          {
            "group": "E-commerce Platforms",
            "pages": [
              "e-commerce-platforms/matajer",
              "e-commerce-platforms/salla"
            ]
          },
          {
            "group": "Authentication",
            "pages": [
              "authentication/api-keys",
              "authentication/ip-whitelisting",
              "authentication/security"
            ]
          },
          {
            "group": "Integration Guide",
            "pages": [
              "integration/checkout-flow",
              "integration/earning-methods",
              "integration/order-lifecycle",
              "integration/refunds-cancellations"
            ]
          },
          {
            "group": "Webhooks",
            "pages": [
              "webhooks/overview",
              "webhooks/events",
              "webhooks/management"
            ]
          },
          {
            "group": "Widgets",
            "pages": [
              "widgets/overview",
              "widgets/widget-playground"
            ]
          },
          {
            "group": "SDKs",
            "pages": [
              "sdk/php-sdk"
            ]
          },
          {
            "group": "Testing",
            "pages": [
              "testing/credentials",
              "testing/go-live-checklist"
            ]
          }
        ]
      },
      {
        "tab": "API Reference",
        "openapi": "openapi/points-api-v1.yaml"
      }
    ]
  },
  "logo": {
    "light": "/logo/points-logo-color.png",
    "dark": "/logo/points-logo-white.png"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:support@papp.sa"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Register",
      "href": "https://business.papp.sa"
    }
  },
  "footer": {
    "socials": {
      "x": "https://x.com/PointsAppSa",
      "instagram": "https://instagram.com/pointsappsa",
      "linkedin": "https://linkedin.com/company/pointsappsa"
    }
  },
  "redirects": [
    { "source": "/integration/earn-only", "destination": "/integration/earning-methods#order-purchase" },
    { "source": "/integration/earn-store-rating", "destination": "/integration/earning-methods#store-rating" },
    { "source": "/integration/earn-product-rating", "destination": "/integration/earning-methods#product-rating" },
    { "source": "/integration/redeem-flow", "destination": "/integration/checkout-flow" },
    { "source": "/integration/order-statuses", "destination": "/integration/order-lifecycle" },
    { "source": "/webhooks/handling", "destination": "/webhooks/overview#handling-webhooks" },
    { "source": "/widgets/product-widget", "destination": "/widgets/overview#quick-start--product-page" },
    { "source": "/widgets/checkout-widget", "destination": "/widgets/overview#quick-start--checkout" },
    { "source": "/widgets/customization", "destination": "/widgets/overview#configuration" },
    { "source": "/widgets/implementation-guidelines", "destination": "/widgets/overview#implementation-guidelines" },
    { "source": "/sdk/overview", "destination": "/sdk/php-sdk" }
  ]
}
